{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}@geocore.credits@",
    "contact": {
        "homepage": "@geocore.homepage@",
        "sources": "@geocore.sources@",
        "issues": "@geocore.issues@"
    },
    "authors": [
        "${mod_author}"
    ],
    "license": "${mod_license}",
    "environment": "*",
    "entrypoints": {
        "main": [
            "fr.geoventure.geocore.platform.FabricEntrypoint"
        ],
        "client": [
            "fr.geoventure.geocore.platform.FabricClientEntrypoint",
            "fr.geoventure.geocore.harness.HarnessFabricClient"
        ]
    },
    "mixins": [
        "geocore.mixins.json",
        "geocore.fabric.mixins.json",
        "geocore.harness.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader}",
        "minecraft": "${minecraft_range}",
        "java": ">=${java_version}"
    },
    "breaks": {
        "gemrender": "<0.1.21"
    }
}
